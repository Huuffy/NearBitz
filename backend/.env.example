DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sales_app

JWT_SECRET=generate-with--node-e--"console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# data.gov.in API key — free at https://data.gov.in → register → profile → API Key
DATAGOV_API_KEY=your_datagov_api_key

OSRM_URL=http://router.project-osrm.org
PHOTON_URL=http://localhost:2322

UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=5
MAX_PDF_SIZE_MB=20

PORT=3000
NODE_ENV=development
# Dev: Expo web runs on 8081. For mobile device use your machine's LAN IP.
CORS_ORIGIN=http://localhost:8081
