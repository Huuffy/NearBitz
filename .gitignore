# ── Secrets ──────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Dependencies & build output ──────────────────────────
node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
*.tsbuildinfo

# ── Local-only: client spreadsheets, backups ─────────────
local/

